{
  "name": "perry-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:css --silent && esbuild src/main.js --bundle --format=esm --minify --target=es2020 --outfile=assets/site.js",
    "build:lab": "esbuild src/lab.js --bundle --format=esm --outfile=assets/lab.js",
    "check:css": "esbuild styles/site.css --log-level=warning --log-override:css-syntax-error=error --outdir=node_modules/.cache/css-check",
    "dist": "npm run build --silent && node scripts/dist.mjs",
    "dev": "python3 -m http.server 8790",
    "preview": "python3 -m http.server 8791 --directory dist"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
