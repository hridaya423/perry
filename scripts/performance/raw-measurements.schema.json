{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perry-performance-raw-measurements-v2",
  "title": "Perry raw performance measurements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "perry.performance.raw_measurements"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "captured_at",
        "provenance",
        "machine",
        "build",
        "network"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "collector",
            "command",
            "synthetic"
          ],
          "properties": {
            "kind": {
              "enum": [
                "live",
                "fixture"
              ]
            },
            "collector": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "synthetic": {
              "type": "boolean"
            }
          }
        },
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "architecture",
            "os",
            "os_version",
            "memory_gb"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "os_version": {
              "type": "string",
              "minLength": 1
            },
            "memory_gb": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "commit",
            "configuration",
            "toolchain"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "configuration": {
              "type": "string",
              "minLength": 1
            },
            "toolchain": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "internet_reachable"
          ],
          "properties": {
            "mode": {
              "enum": [
                "offline",
                "ethernet",
                "wifi",
                "cellular",
                "unknown"
              ]
            },
            "internet_reachable": {
              "type": "boolean"
            },
            "rtt_ms": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "collector",
          "unit",
          "samples"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "collector": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
