<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Perry</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.perry.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dev.perry.perry</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Perry can drive the app you're pointing at — only for a task you asked it to do, and you can undo or stop it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Perry hears you only while you hold the talk key — it never listens in the background.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Perry transcribes what you say with Apple Speech, on this Mac, so it can answer. Nothing leaves the Mac for speech.</string>
	<key>PerryIssuesURL</key>
	<string>$(PERRY_ISSUES_URL)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>$(PERRY_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(PERRY_SPARKLE_PUBLIC_KEY)</string>
</dict>
</plist>
